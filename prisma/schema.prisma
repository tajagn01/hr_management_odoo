// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////

enum Role {
  ADMIN
  MANAGER
  EMPLOYEE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveType {
  PAID
  SICK
  UNPAID
}

//////////////////////////////////////////////////
// USER (AUTH + BASIC INFO)
//////////////////////////////////////////////////

model User {
  id                  String      @id @default(uuid())
  email               String      @unique
  password            String
  role                Role        @default(EMPLOYEE)
  isActive            Boolean     @default(true)
  emailVerified       Boolean     @default(false)
  verificationToken   String?
  verificationTokenExpiry DateTime?

  employee            Employee?
  sessions            Session[]

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

//////////////////////////////////////////////////
// EMPLOYEE PROFILE
//////////////////////////////////////////////////

model Employee {
  id              String     @id @default(uuid())
  userId          String     @unique
  employeeCode    String     @unique
  fullName        String
  phone           String?
  address         String?
  designation     String
  department      String
  joiningDate     DateTime
  dateOfBirth     DateTime?  // New: Employee date of birth
  profileImage    String?
  profileCompleted Boolean   @default(false) // New: Track if profile setup is complete
  managerId       String?    // Manager relationship (nullable for top-level employees)

  user            User       @relation(fields: [userId], references: [id])
  manager         Employee?  @relation("ManagerToEmployees", fields: [managerId], references: [id])
  managedEmployees Employee[] @relation("ManagerToEmployees")
  attendance      Attendance[]
  leaves          LeaveRequest[]
  payroll         Payroll?
  monthlyAttendance MonthlyAttendance[]
  yearlyAttendance  YearlyAttendance[]

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([userId])
  @@index([department])
  @@index([designation])
  @@index([managerId])
  @@index([fullName]) // Common sort field
}

//////////////////////////////////////////////////
// ATTENDANCE
//////////////////////////////////////////////////

model Attendance {
  id          String             @id @default(uuid())
  employeeId  String
  date        DateTime
  status      AttendanceStatus
  checkIn     DateTime?
  checkOut    DateTime?
  workingHours Float?            // Working hours calculated on checkout

  employee    Employee           @relation(fields: [employeeId], references: [id])

  createdAt   DateTime           @default(now())

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([employeeId, date]) // existing
  @@index([date, employeeId]) // Optimized for reverse chronological queries
  @@index([date])
  @@index([status])
}

//////////////////////////////////////////////////
// LEAVE MANAGEMENT
//////////////////////////////////////////////////

model LeaveRequest {
  id            String       @id @default(uuid())
  employeeId    String
  type          LeaveType
  startDate     DateTime
  endDate       DateTime
  days          Int
  reason        String?
  status        LeaveStatus  @default(PENDING)

  approvedBy    String?
  approvedAt    DateTime?
  adminComment  String?

  employee      Employee    @relation(fields: [employeeId], references: [id])

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([employeeId])
  @@index([employeeId, createdAt])
  @@index([employeeId, startDate])
  @@index([employeeId, endDate])   // Optimized for range overlap checks
  @@index([status, startDate])     // Optimized for admin dashboard
  @@index([status])
  @@index([createdAt])
}

//////////////////////////////////////////////////
// MONTHLY ATTENDANCE AGGREGATION
//////////////////////////////////////////////////

model MonthlyAttendance {
  id                String   @id @default(uuid())
  employeeId        String
  year              Int
  month             Int      // 1-12
  
  totalWorkingDays  Int
  presentDays       Int
  absentDays        Int
  halfDays          Int
  leaveDays         Int
  totalWorkingHours Float    @default(0)
  attendancePercent Float    @default(0)
  
  // Day-wise breakdown stored as JSON
  // Format: [{date: "2026-01-15", status: "PRESENT", hours: 8.5}, ...]
  dayWiseData       Json?
  
  employee          Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@unique([employeeId, year, month])
  @@index([employeeId])
  @@index([year, month])
  @@index([employeeId, year, month])
}

//////////////////////////////////////////////////
// YEARLY ATTENDANCE AGGREGATION
//////////////////////////////////////////////////

model YearlyAttendance {
  id                   String   @id @default(uuid())
  employeeId           String
  year                 Int
  
  totalWorkingDays     Int
  presentDays          Int
  absentDays           Int
  halfDays             Int
  leaveDays            Int
  totalWorkingHours    Float    @default(0)
  avgAttendancePercent Float    @default(0)
  
  // Month-wise summary stored as JSON
  // Format: [{month: 1, present: 20, absent: 2, leave: 0, hours: 160}, ...]
  monthWiseData        Json?
  
  employee             Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  
  @@unique([employeeId, year])
  @@index([employeeId])
  @@index([year])
}

//////////////////////////////////////////////////
// PAYROLL
//////////////////////////////////////////////////

model Payroll {
  id            String     @id @default(uuid())
  employeeId    String     @unique

  basicSalary   Float
  hra           Float
  allowances    Float
  deductions    Float
  netSalary     Float


  @@index([employeeId])
  employee      Employee  @relation(fields: [employeeId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

//////////////////////////////////////////////////
// AUTH SESSIONS (NextAuth compatible)
//////////////////////////////////////////////////

model Session {
  sessionToken String   @id
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id])
}
