    {
      "id": "0NygGhj1WDTYWWgtS8EDk",
      "type": "text",
      "x": 11481.463739788709,
      "y": -726.7345429677846,
      "width": 1647.715087890625,
      "height": 1750,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
